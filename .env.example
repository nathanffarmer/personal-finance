# Copy to .env and fill in. Never commit .env.

# App-level auth. Leave empty to disable (localhost dev only).
APP_PASSWORD=

# Monarch Money credentials
# MFA secret is the TOTP seed shown when you enable MFA in Monarch.
MONARCH_EMAIL=
MONARCH_PASSWORD=
MONARCH_MFA_SECRET=
MM_SESSION_FILE=secrets/mm_session.pickle

# Google Sheets (Desktop OAuth)
# Download client_secrets.json from Google Cloud Console (Desktop app credentials).
GOOGLE_CLIENT_SECRETS_FILE=secrets/client_secrets.json
GOOGLE_TOKEN_FILE=secrets/token.json
SHEET_ID=

# Cache
CACHE_TTL_ACCOUNTS=300
CACHE_TTL_TRANSACTIONS=60

# Sheet tab names (override if your sheet uses different names)
SHEETS_TAB_ASSUMPTIONS=Assumptions
SHEETS_TAB_TARGETS=Targets
SHEETS_TAB_ACCOUNTS=Accounts
SHEETS_TAB_HOLDINGS=Holdings
SHEETS_TAB_PROJECTIONS=Projections

# CORS for local dev (frontend Vite default)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
